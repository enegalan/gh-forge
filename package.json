{
  "name": "gh-forge",
  "version": "0.1.0",
  "description": "GitHub Achievement Forge (GAF) - plan and execute real GitHub actions to earn GitHub Achievements using accounts you own.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gh-forge": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "cli": "npx tsx src/cli/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
