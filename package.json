{
  "name": "gh-forge",
  "version": "0.1.0",
  "description": "GitHub Achievement Forge - plan and execute real GitHub actions to earn GitHub Achievements using accounts you own.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gh-forge": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "npx tsx src/cli/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
